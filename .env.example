# Public Supabase credentials for Auth + Postgres.
# Never put the service-role key in this file or the Next.js app.
#
# Local: copy to .env.local
# Vercel: Project Settings → Environment Variables (Production + Preview)
#
# Required:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional fallback if you only have the legacy anon key name:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Vapi outbound practice check-in (server-only; never NEXT_PUBLIC_)
# VAPI_API_KEY=your-vapi-private-key
# VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
# VAPI_CUSTOMER_NUMBER=+15555555555
